POSTGRES_PASSWORD=zmien-mnie
JWT_SECRET=wygeneruj-dlugi-losowy-ciag-min-32-znaki
DOMAIN=localhost

# Google Play Billing (subskrypcja „Wygoda”, docs/subskrypcja-v1.0.md). Wszystkie albo żadna; bez nich płatności są wyłączone.
# GOOGLE_PLAY_PACKAGE_NAME=pl.lastsilo.lastsilo
# GOOGLE_SERVICE_ACCOUNT_JSON=   # zawartość JSON klucza konta serwisowego (sekret, nigdy w repo)
# RTDN_AUDIENCE=                 # audience z subskrypcji push Pub/Sub
# RTDN_SERVICE_ACCOUNT_EMAIL=    # konto serwisowe, którym Pub/Sub podpisuje push
# BILLING_ACCOUNT_KEY=           # min. 16 znaków, klucz HMAC obfuscatedAccountId; zmiana zrywa powiązania zakupów

# Google Sign-In (docs/konto-google-v1.0.md). Bez tej zmiennej logowanie Google jest wyłączone.
# GOOGLE_WEB_CLIENT_ID=      # klient OAuth typu Web (ten sam co serverClientId w aplikacji)
# GOOGLE_REQUIRE_NONCE=0      # 1 = odrzucaj tokeny bez nonce
