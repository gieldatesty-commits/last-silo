{
  "name": "lastsilo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx src/sim/sim.ts",
    "audit": "tsx src/audit.ts",
    "sim:world": "tsx src/sim/world-sim.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "fastify": "^5.12.7",
    "google-auth-library": "^10.9.1",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
