<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: systemowy ekran startowy (ikona na tle) w kolorze gry, w jasnym i ciemnym trybie systemu -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ls_bg</item>
        <!-- ikona: Szyb główny z grafik gry (drawable/splash_icon.xml) zamiast ikony aplikacji -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ls_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ls_bg</item>
    </style>
</resources>
